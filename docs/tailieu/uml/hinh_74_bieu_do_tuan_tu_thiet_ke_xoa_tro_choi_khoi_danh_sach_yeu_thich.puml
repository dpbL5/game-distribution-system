@startuml
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 18
skinparam BoxPadding 8
skinparam maxMessageSize 75
hide footbox
autonumber
actor Customer
boundary "WishlistPage\n(Client)" as UI
control "removeFromWishlistAction" as Action
control "WishlistService" as Service
entity "WishlistRepository" as Repo
participant "Prisma" as Prisma
database "PostgreSQL" as DB

Customer -> UI: Chọn xóa Game khỏi Wishlist
UI -> Action: remove(gameId)
Action -> Action: requireAuthenticatedUser()
Action -> Service: removeGame(userId, gameId)
Service -> Repo: findItem(userId, gameId)
Repo -> Prisma: wishlistItem.findFirst(...)
Prisma -> DB: SELECT wishlist_item
DB --> Prisma: Item | null
Prisma --> Repo: Item | null
Repo --> Service: Item | null
alt Không tìm thấy
  Service --> Action: NOT_FOUND
else Tìm thấy
  Service -> Repo: delete(itemId)
  Repo -> Prisma: wishlistItem.delete(...)
  Prisma -> DB: DELETE wishlist_item
  DB --> Prisma: done
  Prisma --> Repo: done
  Repo --> Service: done
  Service --> Action: success
end
Action --> UI: result
UI --> Customer: Cập nhật Wishlist
@enduml
